# Intestazioni di sicurezza per l'hosting statico (Cloudflare Pages, Netlify; per altri server vanno
# riportate nella loro configurazione). La CSP completa è anche nel <meta> di index.html.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: frame-ancestors 'self'; object-src 'none'; base-uri 'none'
